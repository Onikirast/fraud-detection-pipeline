KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=transactions

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=frauddb
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud

# Detection thresholds (Phase 2)
ZSCORE_THRESHOLD=3.0
# Calibrated against generate_transactions.py's actual throughput (~25 users,
# ~1-2 txn/sec system-wide -> ~4 txn/min/user baseline). A 10-min window with
# max 5 was miscalibrated -- baseline alone reaches ~40/10min, 8x the
# threshold, so nearly everyone got flagged. See BUILD_LOG.md. A 1-minute
# window keeps baseline noise low (~4, occasionally up to ~8-10) while a
# deliberate burst (5-8 txns in well under a second) still clears the
# threshold reliably.
VELOCITY_WINDOW_MINUTES=1
VELOCITY_MAX_TXNS=8
